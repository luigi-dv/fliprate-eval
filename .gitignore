results/pilot*
results/*.tmp
results/*.bak

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Hugging Face / datasets downloads, if redirected into the project ---
.cache/
hf_cache/
*.arrow
*.parquet

# --- Logs and scratch ---
*.log
nohup.out
scratch/
tmp/

# --- Local tool settings ---
.claude/settings.local.json
.vscode/
.idea/
*.swp

